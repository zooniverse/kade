<% definition = form_model || LabelExtractorDefinition.new(enabled: true) %>
<%
  config_without_custom_schema = definition.config.to_h.except(LabelExtractors::ConfigurableExtractor::CUSTOM_SCHEMA_FLAG)
  config_json =
    local_assigns[:config_json_value].presence ||
    @config_json_value.presence ||
    pretty_json(config_without_custom_schema)
  build_custom_schema =
    if local_assigns.key?(:build_custom_schema_value)
      local_assigns[:build_custom_schema_value]
    elsif instance_variable_defined?(:@build_custom_schema_value)
      @build_custom_schema_value
    else
      LabelExtractors::ConfigurableExtractor.build_custom_schema?(definition.config)
    end
%>

<%= form_with model: definition, url: form_url, method: form_method do |form| %>
  <%= hidden_field_tag :return_to, local_assigns[:return_to].presence || @return_to %>
  <div class="form-group">
      <%= form.label :module_name %>
      <%= form.text_field :module_name, class: 'form-control' %>
  </div>
  <div class="form-group">
      <%= form.label :extractor_name %>
      <%= form.text_field :extractor_name, class: 'form-control' %>
  </div>
  <div class="form-group">
    <label>
      <%= form.check_box :enabled, checked: definition.enabled? %>
      Enabled
    </label>
  </div>

  <div class="form-group">
    <%= hidden_field_tag 'label_extractor_definition[build_custom_schema]', '0' %>
    <label>
      <%= check_box_tag 'label_extractor_definition[build_custom_schema]', '1', build_custom_schema, id: 'label_extractor_definition_build_custom_schema' %>
      Build custom schema
    </label>
    <p class="help-block">When enabled, KaDE sends a generated Zoobot custom schema to BaJoR and manifest labels omit the data release suffix.</p>
  </div>

  <div class="form-group">
    <%= form.label :config_json, 'Config JSON' %>
    <%= form.text_area :config_json,
      value: config_json,
      class: 'form-control json-editor',
      data: {
        json_editor: true,
        json_field_name: 'Config JSON'
      } %>
    <p class="help-block">Structured JSON only. Arbitrary executable logic is not supported. Valid JSON is formatted when the field loses focus or the form is submitted.</p>
    <p class="help-block json-editor-status" aria-live="polite"></p>
  </div>

  <%= form.submit submit_label, class: 'btn btn-primary' %>
<% end %>
